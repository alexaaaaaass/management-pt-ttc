            vertical-align: top;
        }
        table.data-table tr:nth-child(even) td {
            background-color: #f8fafc;
        }
        .text-center { text-align: center; }
        .text-right { text-align: right; }

        /* BOXES & CALLOUTS */
        .box-highlight {
            background-color: #eff6ff;
            border-left: 4px solid #2563eb;
            padding: 7px 10px;
            margin: 7px 0;
            border-radius: 3px;
            font-size: 8.8px;
        }
        .box-amber {
            background-color: #fffbeb;
            border-left: 4px solid #d97706;
            padding: 7px 10px;
            margin: 7px 0;
            border-radius: 3px;
            font-size: 8.6px;
        }
        .box-green {
            background-color: #f0fdf4;
            border-left: 4px solid #16a34a;
            padding: 7px 10px;
            margin: 7px 0;
            border-radius: 3px;
            font-size: 8.6px;
        }

        /* BADGES */
        .badge {
            display: inline-block;
            padding: 1.5px 5.5px;
            border-radius: 3px;
            font-size: 7.4px;
            font-weight: bold;
            text-transform: uppercase;
        }
        .badge-green  { background-color: #dcfce7; color: #166534; }
        .badge-blue   { background-color: #dbeafe; color: #1e40af; }
        .badge-amber  { background-color: #fef3c7; color: #92400e; }
        .badge-purple { background-color: #f3e8ff; color: #6b21a8; }
        .badge-red    { background-color: #fee2e2; color: #991b1b; }
        .badge-gray   { background-color: #e2e8f0; color: #334155; }

        /* FLOW CARDS */
        .flow-step {
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-left: 4px solid #2563eb;
            border-radius: 4px;
            padding: 5.5px 9px;
            margin-bottom: 5.5px;
            font-size: 8.5px;
        }
        .flow-step.teal   { border-left-color: #0d9488; }
        .flow-step.amber  { border-left-color: #d97706; }
        .flow-step.purple { border-left-color: #7c3aed; }
        .flow-step.green  { border-left-color: #16a34a; }
        .step-num {
            background-color: #1d4ed8;
            color: #ffffff;
            font-weight: bold;
            padding: 1.5px 6px;
            border-radius: 9px;
            font-size: 7.8px;
            margin-right: 5px;
            display: inline-block;
        }
        .step-num.teal   { background-color: #0d9488; }
        .step-num.amber  { background-color: #d97706; }
        .step-num.purple { background-color: #7c3aed; }
        .step-num.green  { background-color: #16a34a; }

        /* VISUAL FLOWCHART GRID */
        table.flow-grid {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 2px;
            margin: 6px 0 8px 0;
        }
        table.flow-grid td {
            border: none;
            padding: 2px;
            vertical-align: middle;
        }
        .fnode, table.flow-grid td.fnode {
            border: 1px solid #93c5fd;
            background-color: #eff6ff;
            border-radius: 4px;
            padding: 5px 5px;
            text-align: center;
            font-size: 7.5px;
            line-height: 1.35;
            color: #0f172a;
        }
        .fnode strong, table.flow-grid td.fnode strong {
            display: block;
            color: #1e3a8a;
            font-size: 7.8px;
            margin-bottom: 2px;
        }
        .fnode.green, table.flow-grid td.fnode.green {
            border-color: #86efac;
            background-color: #f0fdf4;
        }
        .fnode.green strong, table.flow-grid td.fnode.green strong { color: #166534; }
        .fnode.amber, table.flow-grid td.fnode.amber {
            border-color: #fcd34d;
            background-color: #fffbeb;
        }
        .fnode.amber strong, table.flow-grid td.fnode.amber strong { color: #92400e; }
        .fnode.purple, table.flow-grid td.fnode.purple {
            border-color: #d8b4fe;
            background-color: #faf5ff;
        }
        .fnode.purple strong, table.flow-grid td.fnode.purple strong { color: #6b21a8; }
        .farrow {
            text-align: center;
            font-size: 10px;
            font-weight: bold;
            color: #2563eb;
            width: 13px;
        }
        .farrow-down {
            text-align: center;
            font-size: 11px;
            font-weight: bold;
            color: #2563eb;
            padding: 1px 0;
        }

        /* TWO-COLUMN LAYOUT */
        table.two-col {
            width: 100%;
            border-collapse: collapse;
            margin: 4px 0 6px 0;
        }
        table.two-col > tbody > tr > td {
            width: 50%;
            vertical-align: top;
            border: none;
            padding: 0 5px 0 0;
        }
        table.two-col > tbody > tr > td:last-child {
            padding: 0 0 0 5px;
        }
        .card-panel {
            border: 1px solid #cbd5e1;
            border-radius: 5px;
            padding: 7px 9px;
            background-color: #ffffff;
            margin-bottom: 6px;
        }
        .card-panel-title {
            font-size: 8.8px;
            font-weight: bold;
            color: #1e3a8a;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 3px;
            margin-bottom: 5px;
        }
    </style>
</head>
